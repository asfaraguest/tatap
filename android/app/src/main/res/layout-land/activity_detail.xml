<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_overscan_horizontal"
    android:paddingEnd="@dimen/tv_overscan_horizontal"
    android:paddingTop="@dimen/tv_overscan_vertical"
    android:paddingBottom="@dimen/tv_overscan_vertical"
    android:clipToPadding="false"
    android:background="@color/bg_root">

    <!-- Top App Bar (44dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@color/bg_root">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:focusable="true"
            android:nextFocusDown="@+id/btn_quick_play"
            android:nextFocusRight="@+id/rv_detail_seasons"
            app:tint="#F1F5F9"
            android:contentDescription="Kembali" />

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Detail Anime"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/pb_detail_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:indeterminateTint="@color/text_accent" />
    </LinearLayout>

    <!-- 2-Column Split Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false">

        <!-- LEFT COLUMN: Info & Metadata Hero Panel (40% width) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:strokeColor="@color/border_soft"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Poster + Title Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Poster Card -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="85dp"
                            android:layout_height="120dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/bg_surface_elevated">

                            <ImageView
                                android:id="@+id/iv_detail_poster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Poster" />
                        </androidx.cardview.widget.CardView>

                        <!-- Title & Badges Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_detail_title_full"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Judul Anime"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/detail_title_text_size"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold"
                                android:lineSpacingExtra="1.5dp" />

                            <!-- Badges Row: Format, Score, Status -->
                            <LinearLayout
                                android:id="@+id/layout_detail_badges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="5dp">

                                <TextView
                                    android:id="@+id/tv_detail_type_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_type"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="TV SERIES"
                                    android:textColor="#E2E8F0"
                                    android:textSize="@dimen/tv_badge_text_size"
                                    android:fontFamily="sans-serif-medium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_detail_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_detail_score"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="#F59E0B"
                                    android:textSize="@dimen/tv_badge_text_size"
                                    android:fontFamily="sans-serif-medium"
                                    android:textStyle="bold"
                                    app:drawableStartCompat="@drawable/ic_star_filled"
                                    app:drawableTint="#F59E0B"
                                    android:drawablePadding="3dp"
                                    android:gravity="center_vertical"
                                    android:visibility="gone"
                                    android:text="8.7" />

                                <TextView
                                    android:id="@+id/tv_detail_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_detail_status_ongoing"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="#38BDF8"
                                    android:textSize="@dimen/tv_badge_text_size"
                                    android:fontFamily="sans-serif-medium"
                                    android:textStyle="bold"
                                    android:visibility="gone"
                                    android:text="ONGOING" />
                            </LinearLayout>

                            <!-- Info Line (Studio / Musim / Sumber) -->
                            <TextView
                                android:id="@+id/tv_detail_info_line"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#94A3B8"
                                android:textSize="@dimen/detail_meta_text_size"
                                android:fontFamily="sans-serif"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:visibility="gone"
                                android:text="Studio: Ufotable · Fall 2024" />

                            <TextView
                                android:id="@+id/tv_detail_slug"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Memuat episode..."
                                android:textColor="#8B95A5"
                                android:textSize="@dimen/detail_meta_text_size"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Action Buttons (Apple Flat Capsule Style) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_play"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Putar 1"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0A84FF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:focusable="true"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:nextFocusUp="@+id/btn_back"
                            android:nextFocusRight="@+id/btn_detail_bookmark"
                            android:nextFocusDown="@+id/btn_toggle_synopsis"
                            app:icon="@drawable/ic_play"
                            app:iconSize="14dp"
                            app:iconPadding="6dp"
                            app:iconGravity="textStart"
                            app:iconTint="#FFFFFF"
                            app:strokeColor="#0A84FF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            android:paddingHorizontal="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_detail_bookmark"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_star_outline"
                            app:iconTint="#A1A1A6"
                            app:iconPadding="4dp"
                            app:iconSize="14dp"
                            app:iconGravity="textStart"
                            android:text="+ Favorit"
                            android:textColor="#F5F5F7"
                            android:backgroundTint="#26262B"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:focusable="true"
                            android:nextFocusUp="@+id/btn_back"
                            android:nextFocusLeft="@+id/btn_quick_play"
                            android:nextFocusRight="@+id/rv_episodes"
                            android:nextFocusDown="@+id/btn_toggle_synopsis"
                            app:strokeColor="#33FFFFFF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            android:paddingHorizontal="10dp" />
                    </LinearLayout>

                    <!-- Genre Chips Row -->
                    <HorizontalScrollView
                        android:id="@+id/hsv_detail_genres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none"
                        android:overScrollMode="never"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/ll_detail_genres"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Synopsis Box (Apple Subhead Box) -->
                    <LinearLayout
                        android:id="@+id/layout_detail_synopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_detail_synopsis"
                        android:padding="9dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SINOPSIS"
                            android:textColor="#86868B"
                            android:textSize="@dimen/tv_badge_text_size"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_detail_synopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#D1D1D6"
                            android:textSize="@dimen/detail_synopsis_text_size"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:text="Memuat sinopsis..." />

                        <TextView
                            android:id="@+id/btn_toggle_synopsis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:paddingVertical="3dp"
                            android:paddingHorizontal="8dp"
                            android:text="Selengkapnya ▼"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/tab_text_size"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_toggle_synopsis"
                            android:clickable="true"
                            android:focusable="true"
                            android:nextFocusUp="@+id/btn_quick_play"
                            android:nextFocusRight="@+id/rv_episodes" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- RIGHT COLUMN: Seasons, Header, Ranges, & Episode Grid (60% width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60"
            android:orientation="vertical">

            <!-- Seasons & Relations Section -->
            <LinearLayout
                android:id="@+id/layout_detail_seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEASON / RELASI TERKAIT"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_detail_seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:orientation="horizontal"
                    android:nextFocusLeft="@+id/btn_quick_play"
                    android:nextFocusDown="@+id/btn_sort_order" />
            </LinearLayout>

            <!-- Section Header (Daftar Episode & Sort Order) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daftar Episode"
                    android:textColor="#94A3B8"
                    android:textSize="@dimen/section_title_text_size"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_sort_order"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Urutan: 1 - N"
                    android:textColor="#E2E8F0"
                    android:backgroundTint="#11141C"
                    android:textSize="@dimen/tab_text_size"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_quick_play"
                    android:nextFocusDown="@+id/rv_episodes"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <!-- Episode Ranges Filter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episode_ranges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:visibility="gone"
                android:nextFocusLeft="@+id/btn_quick_play"
                android:nextFocusUp="@+id/btn_sort_order"
                android:nextFocusDown="@+id/rv_episodes" />

            <!-- Episode Grid (Takes full remaining vertical space) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:nextFocusLeft="@+id/btn_quick_play"
                android:nextFocusUp="@+id/rv_episode_ranges"
                android:scrollbars="vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
