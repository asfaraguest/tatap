<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300F0FF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="#2418283E" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#00F0FF" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="#3300F0FF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#00F0FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="#181C2B" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#22273D" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
