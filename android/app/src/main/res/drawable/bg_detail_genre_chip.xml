<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#2C2E38" />
            <stroke
                android:width="1.5dp"
                android:color="#0A84FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#32323A" />
            <stroke
                android:width="1.5dp"
                android:color="#0A84FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#26262B" />
            <stroke
                android:width="1dp"
                android:color="#32323A" />
        </shape>
    </item>
</selector>
