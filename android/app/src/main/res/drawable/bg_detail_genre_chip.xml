<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#22273D" />
            <stroke
                android:width="1.2dp"
                android:color="#00F0FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#282E47" />
            <stroke
                android:width="1.2dp"
                android:color="#00F0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#181C2B" />
            <stroke
                android:width="1dp"
                android:color="#22273D" />
        </shape>
    </item>
</selector>
