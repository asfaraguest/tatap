<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daftar Perintah (:command)"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_close_help_dialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_close"
            android:drawableTint="#8892B0"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk salah satu perintah di bawah ini untuk menjalankannya langsung:"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item: :season -->
            <LinearLayout
                android:id="@+id/cmd_item_season"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":season [winter|spring|summer|fall] [tahun]"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter anime spesifik per musim &amp; tahun (misal: :season fall 2024)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :source -->
            <LinearLayout
                android:id="@+id/cmd_item_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":source [hi|otaku]"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganti sumber streaming: HiAnime (Multi-sub) / Otakudesu (Sub Indo)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :ping -->
            <LinearLayout
                android:id="@+id/cmd_item_ping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":ping"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periksa latensi &amp; kesehatan backend internal Python"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :ai -->
            <LinearLayout
                android:id="@+id/cmd_item_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":ai"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buka panel dialog konfigurasi AI Translate &amp; Preset API Key"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :apikey -->
            <LinearLayout
                android:id="@+id/cmd_item_apikey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":apikey [key]"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periksa status API key atau simpan key AI (Gemini, Groq, Ollama, OpenAI)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :gemini -->
            <LinearLayout
                android:id="@+id/cmd_item_gemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":gemini &lt;key&gt;"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset Google AI Studio (Model gemini-2.0-flash)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :groq -->
            <LinearLayout
                android:id="@+id/cmd_item_groq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":groq &lt;key&gt;"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset Groq Cloud gratis (Model llama-3.3-70b-versatile)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :ollama -->
            <LinearLayout
                android:id="@+id/cmd_item_ollama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":ollama &lt;key&gt;"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset Ollama Cloud (Model gpt-oss:20b)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :model -->
            <LinearLayout
                android:id="@+id/cmd_item_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":model [nama]"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat atau ganti model LLM yang digunakan untuk translate"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :logs -->
            <LinearLayout
                android:id="@+id/cmd_item_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":logs"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buka riwayat log aktivitas penerjemahan subtitle VTT"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :safemode -->
            <LinearLayout
                android:id="@+id/cmd_item_safemode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=":safemode"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_code"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_safemode_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AKTIF"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_badge"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge_score"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_safemode_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sembunyikan konten vulgar, ecchi &amp; dewasa dari katalog dan pencarian (ketuk untuk on/off)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Item: :haptic (Auto-toggle ON/OFF) -->
            <LinearLayout
                android:id="@+id/cmd_item_haptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=":haptic"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_code"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_haptic_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AKTIF"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_badge"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge_score"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_haptic_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Umpan balik getaran sentuh UI (ketuk untuk on/off)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Item: :update -->
            <LinearLayout
                android:id="@+id/cmd_item_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":update"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periksa pembaruan rilis Tatap terbaru di GitHub (on-demand)"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Item: :clear -->
            <LinearLayout
                android:id="@+id/cmd_item_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_tag"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":clear"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_code"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bersihkan pencarian &amp; reset filter kembali ke musim ini"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
