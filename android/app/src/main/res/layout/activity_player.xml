<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090A0F">

    <!-- Panggung Video (Player View + Overlays) -->
    <FrameLayout
        android:id="@+id/fl_player_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Native Media3 PlayerView -->
        <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="3000"
        app:show_next_button="true"
        app:show_previous_button="true"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Press and Hold Speed / Rewind HUD Pill -->
    <LinearLayout
        android:id="@+id/hud_hold_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_player_hud_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="9dp"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_hold_speed_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textColor="@color/text_accent"
            android:textSize="@dimen/text_title_large" />

        <TextView
            android:id="@+id/tv_hold_speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="2X Cepat >>"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_medium"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Gesture HUD OSD (Volume, Brightness, Seek) -->
    <LinearLayout
        android:id="@+id/hud_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_player_hud_pill"
        android:paddingHorizontal="22dp"
        android:paddingVertical="10dp"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_osd_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textColor="@color/text_accent"
            android:textSize="@dimen/text_subhead"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />

        <ProgressBar
            android:id="@+id/pb_osd_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/text_accent" />

        <TextView
            android:id="@+id/tv_osd_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="50%"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_medium"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Double Tap Ripple Indicators -->
    <TextView
        android:id="@+id/tv_ripple_left"
        android:layout_width="148dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:gravity="center"
        android:text="-5s"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:background="@drawable/bg_ripple_seek_left"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_ripple_right"
        android:layout_width="148dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center"
        android:text="+5s"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:background="@drawable/bg_ripple_seek_right"
        android:visibility="gone" />

    <!-- Minimalist Buffering & Stream Preparation HUD -->
    <LinearLayout
        android:id="@+id/layout_buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120dp"
        android:maxWidth="260dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@drawable/bg_buffering_hud"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pb_buffering"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/text_accent" />

        <TextView
            android:id="@+id/tv_buffering_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="MENYIAPKAN STREAM..."
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Subtitle Custom Overlay -->
    <TextView
        android:id="@+id/tv_subtitles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:layout_marginHorizontal="24dp"
        android:maxWidth="580dp"
        android:elevation="25dp"
        android:background="@drawable/bg_subtitle_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:gravity="center"
        android:textAlignment="center"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="16.5sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.2"
        android:shadowColor="#000000"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="4"
        android:visibility="gone" />

    <!-- Floating Skip Opening / Ending Button -->
    <Button
        android:id="@+id/btn_skip_op_ed"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="72dp"
        android:backgroundTint="#D90F172A"
        app:strokeColor="#38BDF8"
        app:strokeWidth="1.5dp"
        app:cornerRadius="19dp"
        app:icon="@drawable/ic_skip_next"
        app:iconTint="#38BDF8"
        app:iconPadding="5dp"
        app:iconSize="15dp"
        android:paddingHorizontal="14dp"
        android:text="Lewati Opening"
        android:textColor="@color/text_accent"
        android:textSize="@dimen/text_subhead"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.03"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusUp="@+id/btn_sub_selector"
        android:visibility="gone" />

    <!-- Top Overlay Header (Minimalist: Back, Title, Unified Status; fungsi pill telah disatukan ke kontrol bawaan ExoPlayer) -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="@dimen/tv_overscan_horizontal"
        android:paddingEnd="@dimen/tv_overscan_horizontal"
        android:background="@drawable/bg_player_top_scrim"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_player_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:background="@drawable/bg_exo_icon_btn"
            android:src="@drawable/ic_arrow_back"
            android:focusable="true"
            app:tint="@color/text_primary"
            android:contentDescription="Kembali" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memuat Video..."
                android:textColor="@color/text_primary"
                android:textSize="@dimen/player_title_text_size"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_sub_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Subtitle: Auto (Indonesia)"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/tv_card_meta_text_size"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Wadah tersembunyi untuk kompatibilitas mundur ID pill lama (seluruh fungsi disatukan ke kontrol bawaan ExoPlayer) -->
        <LinearLayout
            android:id="@+id/layout_legacy_top_pills"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

        <!-- Tombol Picture-in-Picture (Mobile Only) -->
        <Button
            android:id="@+id/btn_pip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:text="PiP"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_pip"
            app:iconTint="@color/text_primary"
            app:iconSize="15dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:focusable="false"
            android:visibility="gone" />

        <!-- Tombol Skala Layar / Mode Fullscreen (Fit, Zoom, Fill) -->
        <Button
            android:id="@+id/btn_aspect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="13dp"
            android:text="Fit"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:nextFocusLeft="@+id/btn_player_back"
            android:nextFocusRight="@+id/btn_quality"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:visibility="gone" />

        <!-- Tombol Pilihan Resolusi / Kualitas Video -->
        <Button
            android:id="@+id/btn_quality"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="13dp"
            android:text="HD"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:nextFocusLeft="@+id/btn_aspect"
            android:nextFocusRight="@+id/btn_speed"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:visibility="gone" />

        <!-- Tombol Pilihan Kecepatan Putar Video -->
        <Button
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="13dp"
            android:text="1.0x"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:nextFocusLeft="@+id/btn_quality"
            android:nextFocusRight="@+id/btn_sub_style"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:visibility="gone" />

        <!-- Tombol Pengaturan Tampilan & Gaya Subtitle -->
        <Button
            android:id="@+id/btn_sub_style"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="13dp"
            android:text="Gaya Sub"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:nextFocusLeft="@+id/btn_speed"
            android:nextFocusRight="@+id/btn_sub_selector"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:visibility="gone" />

        <!-- Tombol Pilihan Subtitle Engine / Bahasa -->
        <Button
            android:id="@+id/btn_sub_selector"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="15dp"
            android:text="Subtitle"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:focusable="false"
            android:nextFocusLeft="@+id/btn_sub_style"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#CC161B26"
            android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Screen Lock Button (Mobile Touch Screen Lock) -->
    <ImageButton
        android:id="@+id/btn_screen_lock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_screen_lock_button"
        android:src="@drawable/ic_lock_open"
        app:tint="#38BDF8"
        android:contentDescription="Kunci Layar"
        android:visibility="gone" />

    <!-- Floating Screen Unlock Button (Visible briefly on tap when locked) -->
    <Button
        android:id="@+id/btn_screen_unlock"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:backgroundTint="#D90F172A"
        app:strokeColor="#38BDF8"
        app:strokeWidth="1.5dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_lock"
        app:iconTint="#38BDF8"
        app:iconPadding="6dp"
        app:iconSize="15dp"
        android:paddingHorizontal="16dp"
        android:text="Buka Kunci"
        android:textColor="@color/text_accent"
        android:textSize="@dimen/text_body_medium"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02" />
    </FrameLayout>

    <!-- Panel Episode Bawah (Hanya Tampil Saat Mode Portrait Mobile) -->
    <LinearLayout
        android:id="@+id/layout_portrait_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/bg_root"
        android:visibility="gone">

        <!-- Info Judul & Episode Aktif + Tombol Kontrol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="@color/bg_surface">

            <!-- Baris Judul & Tombol Kembali Portrait -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_portrait_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Kembali"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_portrait_anime_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Judul Anime"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_large"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_portrait_current_ep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Memutar Episode 1"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Baris Tombol Kontrol Cepat (Subtitle, Kualitas, Kecepatan, Fullscreen) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_portrait_sub"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Subtitle"
                    android:textSize="@dimen/text_badge"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_quality"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Kualitas"
                    android:textSize="@dimen/text_badge"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_speed"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="1.0x"
                    android:textSize="@dimen/text_badge"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btn_portrait_pip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="PiP"
                    android:textSize="@dimen/text_badge"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_pip"
                    app:iconTint="@color/text_primary"
                    app:iconSize="13dp"
                    android:backgroundTint="@color/bg_surface_elevated"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_portrait_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingHorizontal="12dp"
                    android:text="⛶ Full"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_accent"
                    android:backgroundTint="#15233D"
                    app:cornerRadius="16dp"
                    app:strokeColor="#38BDF8"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Header Daftar Episode & Sort Order -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_portrait_ep_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daftar Episode"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_portrait_sort"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Urutan: 1 - N"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/bg_surface"
                android:textSize="@dimen/text_badge"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border_soft"
                app:strokeWidth="1dp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <!-- Range Selector (untuk serial anime > 30 episode) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_portrait_ranges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Grid Episode Vertikal (4 Kolom Mobile) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_portrait_episodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="10dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>

