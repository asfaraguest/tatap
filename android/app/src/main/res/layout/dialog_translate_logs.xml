<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Log Translasi AI"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_close_logs_dialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_menu_toggle"
            android:drawableStart="@drawable/ic_close"
            android:drawableTint="@color/accent_cyan"
            android:padding="7dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#0A0D12"
        android:padding="10dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_translate_logs_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memuat log translasi..."
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_code"
            android:fontFamily="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_refresh_logs"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="[ 更新 · SEGAR ]"
            android:textColor="@color/text_accent"
            android:background="@drawable/bg_menu_toggle"
            android:textSize="@dimen/text_badge"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dismiss_logs"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="[ 閉じる · TUTUP ]"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_menu_toggle"
            android:textSize="@dimen/text_badge"
            android:fontFamily="sans-serif-medium" />
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
