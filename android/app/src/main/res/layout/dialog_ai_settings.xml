<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pengaturan AI Translate"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_close_ai_dialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_close"
            android:drawableTint="#8892B0"
            android:padding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="false" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Status Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_command_banner"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_ai_status_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Key : (Belum disetel)"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_subhead"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_ai_status_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Model   : gemini-3.1-flash-lite"
                    android:textColor="#E1E7EF"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_ai_status_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="API URL : https://generativelanguage.googleapis.com..."
                    android:textColor="#8892B0"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preset Provider AI Cepat:"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:layout_marginBottom="6dp" />

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btn_preset_gemini"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="Google Gemini"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btn_preset_groq"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="Groq (Llama 3)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_preset_openrouter"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="OpenRouter (Free)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btn_preset_cerebras"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:text="Cerebras (Fast)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- API Key Input Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API Key:"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_apikey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="Tempel API key (AQ..., gsk_..., sk-or-..., csk-...)"
                android:textColorHint="#5A6578"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <!-- Model Input Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model LLM (Opsional):"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_model"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="gemini-3.1-flash-lite"
                android:textColorHint="#5A6578"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <!-- API URL Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Endpoint API URL (Opsional):"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:layout_marginBottom="3dp" />

            <EditText
                android:id="@+id/et_ai_apiurl"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="https://generativelanguage.googleapis.com/v1beta/openai"
                android:textColorHint="#5A6578"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- Custom Prompt AI Fansub Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom Prompt AI Fansub (Gaya &amp; Persona):"
                android:textColor="#8892B0"
                android:textSize="11.5sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arahkan persona penerjemah, gaya bahasa (santai/baku), atau istilah anime khusus:"
                android:textColor="#5A6578"
                android:textSize="10sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_ai_custom_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:maxHeight="96dp"
                android:gravity="top|start"
                android:background="@drawable/bg_input_field"
                android:hint="Contoh: Terjemahkan dengan gaya santai &amp; gaul. Gunakan 'aku-kamu'. Jangan terjemahkan istilah jurus..."
                android:textColorHint="#5A6578"
                android:textColor="#F1F5F9"
                android:textSize="11.5sp"
                android:padding="8dp"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:overScrollMode="always"
                android:layout_marginBottom="6dp" />

            <!-- Prompt Template Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btn_prompt_preset_casual"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="Santai"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_prompt_preset_formal"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="Baku"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_prompt_preset_wibu"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="Jurus"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#161922"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_prompt_preset_reset"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:textColor="#EF4444"
                    android:backgroundTint="#161922"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btn_ai_view_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Log"
                    android:textColor="#8892B0"
                    android:backgroundTint="#161922"
                    android:textSize="11.5sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_ai_reset_key"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Hapus Key"
                    android:textColor="#EF4444"
                    android:backgroundTint="#161922"
                    android:textSize="11.5sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_ai_save"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Simpan"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#1E2433"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
