<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pilih Genre Anime"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_close_genre_dialog"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_close"
            android:drawableTint="@color/text_muted"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Search/Filter Input -->
    <EditText
        android:id="@+id/et_filter_genre"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_input_field"
        android:hint="Cari genre (misal: Action, Romance)..."
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body_medium"
        android:paddingHorizontal="12dp"
        android:singleLine="true" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pb_genre_loading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:indeterminateTint="@color/accent_cyan" />

    <!-- Genre Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_genres"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Action Bar (Reset filter & Tutup) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_reset_genre_filter"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Hapus Filter"
            android:textColor="@color/text_danger"
            android:backgroundTint="@color/bg_surface_elevated"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dismiss_genre"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Tutup"
            android:textColor="@color/text_muted"
            android:backgroundTint="@color/bg_surface_elevated"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
