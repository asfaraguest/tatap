<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:paddingStart="@dimen/tv_overscan_horizontal"
    android:paddingEnd="@dimen/tv_overscan_horizontal"
    android:paddingTop="@dimen/tv_overscan_vertical"
    android:paddingBottom="@dimen/tv_overscan_vertical"
    android:clipToPadding="false"
    android:background="@color/bg_root">

    <!-- Top App Bar / Modern Unified Header with Clean Fluid Search Bar (44dp) -->
    <LinearLayout
        android:id="@+id/layout_header_root"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_root"
        android:paddingHorizontal="12dp">

        <!-- App Brand Logo / Title (Kapital TATAP) -->
        <TextView
            android:id="@+id/tv_app_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TATAP"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:layout_marginEnd="10dp" />

        <!-- Fluid Search Bar (Clean from icon, pure text field) -->
        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:drawableTint="#64748B"
                android:paddingStart="2dp"
                android:hint="Cari anime atau :command..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_medium"
                android:fontFamily="sans-serif"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Clear Search Button (Hanya muncul saat ada teks diketik) -->
            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_close"
                android:drawableTint="#64748B"
                android:padding="4dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Status Online Server Icon (Antara Search Bar & Tombol Menu) -->
        <ImageView
            android:id="@+id/btn_status_power"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_pill"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_server"
            app:tint="#10B981"
            android:layout_marginEnd="8dp"
            android:contentDescription="Status Backend Server" />

        <!-- Header Quick Menu Button -->
        <TextView
            android:id="@+id/btn_toggle_menu"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_menu_toggle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:nextFocusDown="@+id/btn_tab_musim"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:drawableStart="@drawable/ic_more_vert"
            android:drawablePadding="4dp"
            android:drawableTint="#CBD5E1"
            android:text="Menu"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Command Execution Feedback Banner -->
    <LinearLayout
        android:id="@+id/layout_command_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_command_banner"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_command_output"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Command OK"
            android:textColor="@color/text_accent"
            android:textSize="@dimen/text_code"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_close_command_banner"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_close"
            android:drawableTint="#64748B"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Active Filter Badge Bar (Genre, Season, Search) -->
    <LinearLayout
        android:id="@+id/layout_active_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_active_filter_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genre: Action"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_clear_filter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_close"
                android:drawableTint="#38BDF8"
                android:padding="5dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tombol Hapus Semua Riwayat -->
        <TextView
            android:id="@+id/btn_clear_history_all"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Hapus Semua"
            android:textColor="@color/text_danger"
            android:textSize="@dimen/text_badge"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Modern Horizontal Scrollable Category Pills Carousel (36dp) -->
    <HorizontalScrollView
        android:id="@+id/layout_tabs_segmented"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/layout_tabs_container"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1. Tab Musim Ini -->
            <TextView
                android:id="@+id/btn_tab_musim"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_active"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/layout_search_box"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_musim"
                android:nextFocusRight="@+id/btn_tab_airing"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_season"
                android:drawablePadding="5dp"
                android:drawableTint="#FFFFFF"
                android:text="Musim Ini"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 2. Tab Masih Tayang -->
            <TextView
                android:id="@+id/btn_tab_airing"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/layout_search_box"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_musim"
                android:nextFocusRight="@+id/btn_tab_jadwal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_airing"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Masih Tayang"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 3. Tab Jadwal -->
            <TextView
                android:id="@+id/btn_tab_jadwal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_status_power"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_airing"
                android:nextFocusRight="@+id/btn_tab_riwayat"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_schedule"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Jadwal"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 4. Tab Riwayat -->
            <TextView
                android:id="@+id/btn_tab_riwayat"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_status_power"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_jadwal"
                android:nextFocusRight="@+id/btn_tab_favorit"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_history"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Riwayat"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 5. Tab Favorit -->
            <TextView
                android:id="@+id/btn_tab_favorit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_riwayat"
                android:nextFocusRight="@+id/btn_tab_katalog"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_favorite"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Favorit"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 6. Tab Katalog -->
            <TextView
                android:id="@+id/btn_tab_katalog"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_favorit"
                android:nextFocusRight="@+id/btn_tab_genre"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_catalog"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Katalog"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <!-- 7. Tab Genre -->
            <TextView
                android:id="@+id/btn_tab_genre"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/btn_toggle_menu"
                android:nextFocusDown="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_tab_katalog"
                android:nextFocusRight="@+id/btn_tab_genre"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@drawable/ic_tab_genre"
                android:drawablePadding="5dp"
                android:drawableTint="#8892B0"
                android:text="Genre"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 7-Day Schedule Chip Selector (Senin - Minggu) -->
    <HorizontalScrollView
        android:id="@+id/layout_schedule_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_day_senin"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Senin"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_selasa"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Selasa"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_rabu"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Rabu"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_kamis"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Kamis"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_jumat"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Jumat"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_sabtu"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Sabtu"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_day_minggu"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="62dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Minggu"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Section Title & Counter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tayang Musim Ini"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/btn_filter_catalog"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_header_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_filter"
            android:drawablePadding="5dp"
            android:drawableTint="#38BDF8"
            android:text="Filter"
            android:textColor="@color/text_accent"
            android:textSize="@dimen/text_subhead"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Content Area with Floating Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <!-- Swipe Refresh Layout with Anime Grid & Empty/Error State -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false">

                <!-- Native Grid of Anime Cards with Entrance Cascade Animation -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_anime_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="9dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="64dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layoutAnimation="@anim/grid_layout_animation"
                    android:scrollbars="vertical" />

                <!-- Central Loading State (Animasi Loading Utama di Tengah Konten) -->
                <LinearLayout
                    android:id="@+id/layout_loading_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <ProgressBar
                        android:id="@+id/pb_central_loading"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="#38BDF8" />

                    <TextView
                        android:id="@+id/tv_loading_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Memuat data anime..."
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_body_medium"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.02" />
                </LinearLayout>

                <!-- Empty / Error Placeholder View -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak Ada Anime Ditemukan"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_large"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Coba gunakan kata kunci lain atau periksa koneksi backend."
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_body_medium"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/btn_empty_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_page_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Coba Lagi"
                        android:textColor="@color/text_accent"
                        android:textSize="@dimen/text_subhead"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Floating Transparent Pagination Bar -->
        <LinearLayout
            android:id="@+id/layout_pagination"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_floating_pagination"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/btn_prev_page"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_floating_page_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@+id/rv_anime_grid"
                android:nextFocusRight="@+id/btn_next_page"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Sebelumnya"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_floating_page_indicator"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Hal 1"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btn_next_page"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_floating_page_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@+id/rv_anime_grid"
                android:nextFocusLeft="@+id/btn_prev_page"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Berikutnya"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
