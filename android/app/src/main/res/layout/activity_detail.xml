<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_overscan_horizontal"
    android:paddingEnd="@dimen/tv_overscan_horizontal"
    android:paddingTop="@dimen/tv_overscan_vertical"
    android:paddingBottom="@dimen/tv_overscan_vertical"
    android:clipToPadding="false"
    android:background="@color/bg_root">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_root">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:focusable="true"
            android:nextFocusDown="@+id/btn_quick_play"
            app:tint="#F1F5F9"
            android:contentDescription="Kembali" />

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Detail Anime"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/pb_detail_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:indeterminateTint="@color/text_accent" />
    </LinearLayout>

    <!-- Hero Card Banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:strokeColor="@color/border_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Poster Thumbnail -->
                <androidx.cardview.widget.CardView
                    android:layout_width="85dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#161A24">

                    <ImageView
                        android:id="@+id/iv_detail_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Poster" />
                </androidx.cardview.widget.CardView>

                <!-- Metadata Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_detail_title_full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="Judul Anime"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2.5dp" />

                    <!-- Badges Row: Format, Score, Status -->
                    <LinearLayout
                        android:id="@+id/layout_detail_badges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:id="@+id/tv_detail_type_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_type"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:text="TV SERIES"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_badge"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/tv_detail_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_detail_score"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:textColor="#F59E0B"
                            android:textSize="@dimen/text_badge"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.02"
                            app:drawableStartCompat="@drawable/ic_star_filled"
                            app:drawableTint="#F59E0B"
                            android:drawablePadding="3dp"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            android:text="8.7" />

                        <TextView
                            android:id="@+id/tv_detail_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_detail_status_ongoing"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/text_badge"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:visibility="gone"
                            android:text="ONGOING" />
                    </LinearLayout>

                    <!-- Info Line (Studio / Musim / Sumber) -->
                    <TextView
                        android:id="@+id/tv_detail_info_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone"
                        android:text="Studio: Ufotable · Fall 2024" />

                    <TextView
                        android:id="@+id/tv_detail_slug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Memuat episode..."
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif" />

                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons Row (Apple Flat Capsule Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quick_play"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Putar 1"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0A84FF"
                    android:textSize="@dimen/text_subhead"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:focusable="true"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:nextFocusUp="@+id/btn_back"
                    android:nextFocusDown="@+id/btn_sort_order"
                    android:nextFocusRight="@+id/btn_detail_bookmark"
                    app:icon="@drawable/ic_play"
                    app:iconSize="15dp"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#0A84FF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:paddingHorizontal="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_bookmark"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_star_outline"
                    app:iconTint="#A1A1A6"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconGravity="textStart"
                    android:text="+ Favorit"
                    android:textColor="#F5F5F7"
                    android:backgroundTint="#26262B"
                    android:textSize="@dimen/text_subhead"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_back"
                    android:nextFocusDown="@+id/btn_sort_order"
                    android:nextFocusLeft="@+id/btn_quick_play"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- Genre Chips Row (Horizontal Scroll) -->
            <HorizontalScrollView
                android:id="@+id/hsv_detail_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_detail_genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Container Sinopsis Terlipat (Mobile Only) -->
            <LinearLayout
                android:id="@+id/layout_detail_synopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_detail_synopsis"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SINOPSIS"
                    android:textColor="#86868B"
                    android:textSize="@dimen/text_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/tv_detail_synopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_large"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3.5dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Memuat sinopsis..." />

                <TextView
                    android:id="@+id/btn_toggle_synopsis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="Selengkapnya ▼"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_btn_toggle_synopsis"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Seasons & Relations Section (Prekuel / Season 1 / Sekuel) -->
    <LinearLayout
        android:id="@+id/layout_detail_seasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEASON / RELASI TERKAIT"
            android:textColor="@color/text_accent"
            android:textSize="@dimen/text_badge"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detail_seasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:nextFocusUp="@+id/btn_quick_play"
            android:nextFocusDown="@+id/btn_sort_order" />
    </LinearLayout>

    <!-- Section Header (Daftar Episode & Sort Order) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daftar Episode"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_sort_order"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Urutan: 1 - N"
            android:textColor="@color/text_secondary"
            android:backgroundTint="#11141C"
            android:textSize="@dimen/text_badge"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:nextFocusUp="@+id/btn_quick_play"
            android:nextFocusDown="@+id/rv_episodes"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Episode Ranges Filter (untuk anime dengan 100+ episode seperti One Piece) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_episode_ranges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="14dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:visibility="gone"
        android:nextFocusUp="@+id/btn_sort_order"
        android:nextFocusDown="@+id/rv_episodes" />

    <!-- Episode Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_episodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="11dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:nextFocusUp="@+id/rv_episode_ranges"
        android:scrollbars="vertical" />
</LinearLayout>
