<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:focusableInTouchMode="true"
    android:clipToPadding="false"
    android:background="@color/bg_root">

    <!-- LEFT SIDEBAR (Apple Docked Sidebar ~210dp) -->
    <LinearLayout
        android:id="@+id/layout_tv_sidebar"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- App Brand Logo (Apple Flat Logotype) -->
        <LinearLayout
            android:id="@+id/layout_tv_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_app_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TATAP"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_badge_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_type"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:text="TV"
                android:textColor="@color/text_accent"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Search Bar (Compact Apple Style) -->
        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:nextFocusDown="@+id/btn_tab_musim"
            android:nextFocusRight="@+id/rv_anime_grid">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:drawableTint="#86868B"
                android:hint="Cari anime..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_close"
                android:drawableTint="#86868B"
                android:padding="3dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Vertical Navigation Tabs List -->
        <ScrollView
            android:id="@+id/layout_tabs_segmented"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layout_tabs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Musim Ini -->
                <TextView
                    android:id="@+id/btn_tab_musim"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/layout_search_box"
                    android:nextFocusDown="@+id/btn_tab_airing"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_season"
                    android:drawablePadding="8dp"
                    android:text="Musim Ini"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 2. Masih Tayang -->
                <TextView
                    android:id="@+id/btn_tab_airing"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_musim"
                    android:nextFocusDown="@+id/btn_tab_jadwal"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_airing"
                    android:drawablePadding="8dp"
                    android:text="Masih Tayang"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 3. Jadwal Rilis -->
                <TextView
                    android:id="@+id/btn_tab_jadwal"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_airing"
                    android:nextFocusDown="@+id/btn_tab_riwayat"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_schedule"
                    android:drawablePadding="8dp"
                    android:text="Jadwal"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 4. Riwayat Tontonan -->
                <TextView
                    android:id="@+id/btn_tab_riwayat"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_jadwal"
                    android:nextFocusDown="@+id/btn_tab_favorit"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_history"
                    android:drawablePadding="8dp"
                    android:text="Riwayat"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 5. Favorit -->
                <TextView
                    android:id="@+id/btn_tab_favorit"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_riwayat"
                    android:nextFocusDown="@+id/btn_tab_katalog"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_favorite"
                    android:drawablePadding="8dp"
                    android:text="Favorit"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 6. Katalog Lengkap -->
                <TextView
                    android:id="@+id/btn_tab_katalog"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_favorit"
                    android:nextFocusDown="@+id/btn_tab_genre"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_catalog"
                    android:drawablePadding="8dp"
                    android:text="Katalog"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- 7. Genre Filter -->
                <TextView
                    android:id="@+id/btn_tab_genre"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tv_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_tab_katalog"
                    android:nextFocusDown="@+id/btn_status_power"
                    android:nextFocusRight="@+id/rv_anime_grid"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_tab_genre"
                    android:drawablePadding="8dp"
                    android:text="Genre"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Controls: Server Status & Menu (Apple Flat Row) -->
        <LinearLayout
            android:id="@+id/layout_tv_bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/btn_status_power"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:nextFocusUp="@+id/btn_tab_genre"
                android:nextFocusRight="@+id/btn_toggle_menu"
                android:padding="8dp"
                android:src="@drawable/ic_server"
                app:tint="#30D158"
                android:contentDescription="Status Backend Server" />

            <TextView
                android:id="@+id/btn_toggle_menu"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_menu_toggle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:nextFocusUp="@+id/btn_tab_genre"
                android:nextFocusLeft="@+id/btn_status_power"
                android:nextFocusRight="@+id/rv_anime_grid"
                android:gravity="center"
                android:drawableStart="@drawable/ic_more_vert"
                android:drawablePadding="4dp"
                android:drawableTint="#A1A1A6"
                android:text="Menu"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline Vertical Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/border_soft" />

    <!-- RIGHT WIDESCREEN MAIN CATALOG AREA (Full Vertical Height) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Command Banner -->
        <LinearLayout
            android:id="@+id/layout_command_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_command_banner"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_command_output"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Command OK"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/text_code"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_close_command_banner"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_close"
                android:drawableTint="#64748B"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Active Filter Bar -->
        <LinearLayout
            android:id="@+id/layout_active_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_chip"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_active_filter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Genre: Action"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btn_clear_filter"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:drawableStart="@drawable/ic_close"
                    android:drawableTint="#0A84FF"
                    android:padding="5dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_clear_history_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Hapus Semua"
                android:textColor="@color/text_danger"
                android:textSize="@dimen/text_badge"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sub-Header: Title, Catalog Filter Button, Item Count -->
        <LinearLayout
            android:id="@+id/layout_section_header"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tayang Musim Ini"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/btn_filter_catalog"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_header_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_filter"
                android:drawablePadding="5dp"
                android:drawableTint="#0A84FF"
                android:text="Filter"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/text_subhead"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Horizontal Schedule Days Chips (Hanya muncul saat tab Jadwal dipilih) -->
        <HorizontalScrollView
            android:id="@+id/layout_schedule_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="4dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_day_senin"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Senin"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_selasa"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Selasa"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_rabu"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Rabu"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_kamis"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Kamis"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_jumat"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Jumat"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_sabtu"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Sabtu"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_day_minggu"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="62dp"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Minggu"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Full-Height RecyclerView & Empty/Loading Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_anime_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="56dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:scrollbars="vertical" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/layout_loading_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ProgressBar
                            android:id="@+id/pb_central_loading"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:indeterminateTint="@color/text_accent" />

                        <TextView
                            android:id="@+id/tv_loading_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Memuat data anime..."
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/text_body_medium"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tidak Ada Anime Ditemukan"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_empty_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Coba gunakan kata kunci lain atau periksa koneksi."
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/text_body_medium"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/btn_empty_retry"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_page_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:text="Coba Lagi"
                            android:textColor="@color/text_accent"
                            android:textSize="@dimen/text_subhead"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Floating Transparent Pagination Bar -->
            <LinearLayout
                android:id="@+id/layout_pagination"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_floating_pagination"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/btn_prev_page"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_floating_page_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusUp="@+id/rv_anime_grid"
                    android:nextFocusRight="@+id/btn_next_page"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Sebelumnya"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_page_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_floating_page_indicator"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Hal 1"
                    android:textColor="@color/text_accent"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btn_next_page"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_floating_page_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:nextFocusUp="@+id/rv_anime_grid"
                    android:nextFocusLeft="@+id/btn_prev_page"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Berikutnya"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
