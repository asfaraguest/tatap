#!/bin/bash
set -e

# Resolve absolute path to AppDir
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"

# Simpan environment sistem asli agar tidak mengontaminasi browser / xdg-open / dialog sistem
SYS_PATH="${PATH}"
SYS_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
SYS_PYTHONHOME="${PYTHONHOME:-}"
SYS_PYTHONPATH="${PYTHONPATH:-}"

run_sys() {
    env -u PYTHONHOME -u PYTHONPATH \
        PATH="${SYS_PATH}" \
        LD_LIBRARY_PATH="${SYS_LD_LIBRARY_PATH}" \
        "$@"
}

# Setup runtime environment untuk backend Python internal AppImage
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
export PYTHONHOME="${HERE}/usr"
export PYTHONPATH="${HERE}/usr/lib/python3.11/site-packages:${HERE}/backend:${PYTHONPATH}"
export PYTHONUNBUFFERED=1

# Storage directory (writable)
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tatap"
mkdir -p "${DATA_DIR}/cache"
export TATAP_DATABASE_PATH="${DATA_DIR}/anime.db"
export TATAP_CACHE_DIR="${DATA_DIR}/cache"

# Cleanup function on exit: anggun mematikan backend server dan menutup koneksi SQLite
cleanup() {
    if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM "$SERVER_PID" 2>/dev/null || true
        # Beri toleransi hingga 2 detik agar SQLite dan FastAPI menutup koneksi secara bersih
        for i in {1..20}; do
            if ! kill -0 "$SERVER_PID" 2>/dev/null; then
                break
            fi
            sleep 0.1
        done
        # Kirimkan KILL jika proses backend masih menggantung setelah 2 detik
        if kill -0 "$SERVER_PID" 2>/dev/null; then
            kill -KILL "$SERVER_PID" 2>/dev/null || true
        fi
        wait "$SERVER_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM HUP

# Check if a healthy Tatap server is already running on port 8767
ALREADY_RUNNING=0
if "${HERE}/usr/bin/python3" -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8767/api/ping', timeout=0.8)" >/dev/null 2>&1; then
    ALREADY_RUNNING=1
fi

if [ "$ALREADY_RUNNING" -ne 1 ]; then
    # 1. Clean up any stale/unresponsive process on port 8767
    "${HERE}/usr/bin/python3" -c "import urllib.request; req = urllib.request.Request('http://127.0.0.1:8767/api/shutdown', data=b'', method='POST'); urllib.request.urlopen(req, timeout=0.5)" >/dev/null 2>&1 || true
    fuser -k 8767/tcp >/dev/null 2>&1 || true
    "${HERE}/usr/bin/python3" -c "
import socket, subprocess, os
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(('127.0.0.1', 8767))
    s.close()
except Exception:
    try:
        p = subprocess.run(['lsof', '-ti:8767'], capture_output=True, text=True)
        for pid in p.stdout.strip().split():
            if pid.isdigit() and int(pid) != os.getpid():
                os.kill(int(pid), 9)
    except Exception:
        pass
" >/dev/null 2>&1 || true

    # 2. Start backend server with logging
    SERVER_LOG="${DATA_DIR}/server.log"
    "${HERE}/usr/bin/python3" "${HERE}/backend/main.py" > "$SERVER_LOG" 2>&1 &
    SERVER_PID=$!

    # 3. Wait for server ready (max 15 seconds, polling every 200ms)
    READY=0
    for i in {1..75}; do
        if "${HERE}/usr/bin/python3" -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8767/api/ping', timeout=0.5)" >/dev/null 2>&1; then
            READY=1
            break
        fi
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            break
        fi
        sleep 0.2
    done

    if [ "$READY" -ne 1 ]; then
        ERR_LOG=""
        if [ -f "$SERVER_LOG" ]; then
            ERR_LOG=$(tail -n 15 "$SERVER_LOG")
        fi
        MSG="Server backend Tatap tidak dapat dimulai atau gagal merespons dalam 15 detik pada http://127.0.0.1:8767.\n\nLog Kesalahan:\n${ERR_LOG:-Tidak ada catatan error di log.}"

        if command -v zenity >/dev/null 2>&1; then
            run_sys zenity --error --title="Tatap — Gagal Memulai Backend" --text="$MSG" --width=520 2>/dev/null || true
        elif command -v kdialog >/dev/null 2>&1; then
            run_sys kdialog --error "$MSG" --title "Tatap — Gagal Memulai Backend" 2>/dev/null || true
        elif command -v xmessage >/dev/null 2>&1; then
            run_sys xmessage -center -title "Tatap — Gagal Memulai Backend" "$MSG" 2>/dev/null || true
        elif command -v notify-send >/dev/null 2>&1; then
            run_sys notify-send -u critical "Tatap — Gagal Memulai Backend" "Server backend gagal berjalan. Periksa log di $SERVER_LOG" 2>/dev/null || true
        fi

        echo -e "$MSG" >&2
        exit 1
    fi
fi

# Detect browser for App Mode (frameless window)
APP_URL="http://127.0.0.1:8767"
BROWSER_CMD=""

for candidate in google-chrome google-chrome-stable chromium chromium-browser brave-browser microsoft-edge; do
    if command -v "$candidate" >/dev/null 2>&1; then
        BROWSER_CMD="$candidate"
        break
    fi
done

if [ -n "$BROWSER_CMD" ]; then
    # Run in isolated application window mode with hardware acceleration & minimal CPU overhead
    CHROME_DATA_DIR="${DATA_DIR}/browser-profile"
    mkdir -p "$CHROME_DATA_DIR"
    CHROME_FLAGS=(
        --user-data-dir="$CHROME_DATA_DIR"
        --app="$APP_URL"
        --window-size=1280,720
        --class=Tatap
        # Hardware acceleration & GPU decoding (Mesa VAAPI / NVDEC / Vulkan)
        --enable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,CanvasOopRasterization
        --enable-gpu-rasterization
        --enable-zero-copy
        --ignore-gpu-blocklist
        # Wayland native integration (prevents heavy Xwayland CPU copy overhead)
        --ozone-platform-hint=auto
        # Disable background bloat & telemetry that consume CPU
        --disable-background-networking
        --disable-component-update
        --disable-sync
        --disable-default-apps
        --no-default-browser-check
        --no-first-run
        --disable-breakpad
        --disable-features=Translate,OptimizationHints,MediaRouter
        --audio-buffer-size=2048
    )
    run_sys "$BROWSER_CMD" "${CHROME_FLAGS[@]}" >/dev/null 2>&1 &
    BROWSER_PID=$!

    # Tunggu sampai jendela aplikasi Tatap ditutup oleh pengguna.
    # Dengan --user-data-dir terisolasi, $BROWSER_PID merupakan proses window utama
    # sehingga saat window ditutup, skrip selesai dan memicu trap cleanup untuk mematikan server.
    wait "$BROWSER_PID" 2>/dev/null || true
else
    # Fallback to default system browser (non-Chromium)
    echo "================================================================="
    echo " Tatap: Browser berbasis Chromium tidak ditemukan."
    echo " Membuka peramban default via xdg-open: $APP_URL"
    echo " Server backend berjalan di latar belakang (PID: $SERVER_PID)."
    echo " Tekan Ctrl+C pada terminal ini untuk mematikan server Tatap."
    echo "================================================================="
    if command -v xdg-open >/dev/null 2>&1; then
        run_sys xdg-open "$APP_URL" >/dev/null 2>&1 || true
    elif command -v sensible-browser >/dev/null 2>&1; then
        run_sys sensible-browser "$APP_URL" >/dev/null 2>&1 || true
    fi
    if command -v notify-send >/dev/null 2>&1; then
        run_sys notify-send "Tatap Anime" "Server berjalan di $APP_URL. Tutup terminal atau kirim sinyal untuk mematikan backend." 2>/dev/null || true
    fi

    # Menjaga server tetap aktif saat mode xdg-open sampai pengguna menekan Ctrl+C (INT/TERM)
    # yang kemudian memicu trap cleanup secara otomatis
    wait "$SERVER_PID" 2>/dev/null || true
fi
